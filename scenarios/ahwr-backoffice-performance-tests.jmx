              <stringProp name="RegexExtractor.refname">agreementReference</stringProp>
              <stringProp name="RegexExtractor.regex">&lt;strong&gt;([^&lt;]+)&lt;/strong&gt;</stringProp>
              <stringProp name="RegexExtractor.template">$1$</stringProp>
              <stringProp name="RegexExtractor.default">NOT_FOUND</stringProp>
