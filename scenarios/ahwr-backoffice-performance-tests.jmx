              <stringProp name="parameters"></stringProp>
              <stringProp name="script">def poultryAgreementRef = vars.get(&quot;poultryAgreementReference&quot;)

if (poultryAgreementRef != null &amp;&amp; !props.containsKey(&quot;POULTRY_AGREEMENT_REFERENCE&quot;)) {
    props.put(&quot;POULTRY_AGREEMENT_REFERENCE&quot;, poultryAgreementRef)
    log.info(&quot;POULTRY_AGREEMENT_REFERENCE stored : ${poultryAgreementRef}&quot;)
}
</stringProp>
              <stringProp name="scriptLanguage">groovy</stringProp>
            </JSR223PostProcessor>
