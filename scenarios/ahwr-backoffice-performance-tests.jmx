              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="script">def poultryClaimReference = vars.get(&quot;poultryClaimReference&quot;)

if (poultryClaimReference != null &amp;&amp; !props.containsKey(&quot;POULTRY_CLAIM_REFERENCE&quot;)) {
    props.put(&quot;POULTRY_CLAIM_REFERENCE&quot;, poultryClaimReference)
    log.info(&quot;POULTRY_CLAIM_REFERENCE stored : ${poultryClaimReference}&quot;)
}</stringProp>
              <stringProp name="scriptLanguage">groovy</stringProp>
            </JSR223PostProcessor>
